<?xml version="1.0" encoding="utf-8"?>
<!--
  Manifiesto del paquete MSIX de Ozone PDF 2 para la Microsoft Store.
  Usa la MISMA identidad que la versión 1, así la Store lo entrega como actualización.
  CREAR_MSIX.bat reemplaza los valores entre $...$:
  - $NOMBRE$, $EDITOR$ y $EDITOR_VISIBLE$: salen de msix_identidad.txt (Partner Center >
    Administración de productos > Identidad del producto).
  - $VERSION$: la versión de src-tauri/tauri.conf.json, con cuatro números (2.0.0 -> 2.0.0.0).
  La Store firma el paquete al publicarlo: no hace falta certificado propio.
  La app usa WebView2, que ya viene con Windows 10 (actualizado) y Windows 11.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="$NOMBRE$" Publisher="$EDITOR$" Version="$VERSION$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Ozone PDF</DisplayName>
    <PublisherDisplayName>$EDITOR_VISIBLE$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-AR" />
  </Resources>

  <Applications>
    <Application Id="OzonePDF" Executable="ozone-pdf.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Ozone PDF"
        Description="Editor y herramientas PDF gratis que funcionan sin internet: firmar, anotar, censurar, escanear, unir, dividir, comprimir y más."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- "Abrir con… Ozone PDF" para los archivos .pdf -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="pdf">
            <uap:DisplayName>Documento PDF</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/pdf">.pdf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- programa de escritorio clásico (obligatorio para apps empaquetadas como esta) -->
    <rescap:Capability Name="runFullTrust" />
    <!-- cámara, para "Escanear"; Windows la muestra en Configuración > Privacidad > Cámara -->
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
