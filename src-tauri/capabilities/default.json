{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos: abrir y guardar los PDF que elige la persona. Sin red.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://cafecito.app/*"
        },
        {
          "url": "https://pachelabs.net/*"
        },
        {
          "url": "https://pachelabs.net"
        },
        {
          "url": "https://github.com/pachelabs-apps/*"
        },
        {
          "url": "https://pachelabs.net/*?*#*"
        },
        {
          "url": "https://pachelabs.net/*?*"
        }
      ]
    }
  ]
}